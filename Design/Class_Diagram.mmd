classDiagram
  class User {
    +int id
    +string name
    +string email
    +string password
    +created_at
    +updated_at
  }

  class Order {
    +int id
    +float price
    +string status
    +string delivery_address
    +string delivery_phone
    +string delivery_city
    +created_at
    +updated_at
  }

  class Product {
    +int id
    +string name
    +string description
    +float price
    +created_at
    +updated_at
  }

  class Extra_Topping {
    +int id
    +string name
    +float price
    +created_at
    +updated_at
  }

  class Category {
    +int id
    +string name
    +created_at
    +updated_at
  }

  User "1" --> "*" Order
  Order "*" --> "*" Product : "Order_Product"
  Product "*" --> "*" Extra_Topping : "Product_Extra_Topping"
  Product "*" --> "1" Category
