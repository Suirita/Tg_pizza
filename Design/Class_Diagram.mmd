classDiagram
  class User {
    +int id
    +string name
    +string email
    +string password
    +string phone
    +created_at
    +updated_at
  }

  class Order {
    +int id
    +float price
    +string status
    +string delivery_address
    +created_at
    +updated_at
  }

  class OrderItem {
    +int id
    +int quantity
    +float price
    +created_at
    +updated_at
  }

  class Product {
    +int id
    +string name
    +string description
    +float price
    +created_at
    +updated_at
  }

  class Extra_Topping {
    +int id
    +string name
    +float price
    +created_at
    +updated_at
  }

  class Category {
    +int id
    +string name
    +created_at
    +updated_at
  }

  User "1" --> "*" Order
  Order "1" --> "*" OrderItem
  Product "1" --> "*" OrderItem
  Product "*" --> "1" Category
  Product "*" --> "*" Extra_Topping
